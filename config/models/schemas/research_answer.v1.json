{
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis", "claims", "assumptions", "abstain", "reason", "tool_requests"],
  "properties": {
    "hypothesis": {"type": "string", "maxLength": 4000},
    "claims": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "span_ids", "quote", "numbers"],
        "properties": {
          "text": {"type": "string", "minLength": 1, "maxLength": 1000},
          "span_ids": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
          "quote": {"anyOf": [{"type": "string", "maxLength": 1000}, {"type": "null"}]},
          "numbers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["concept", "period", "unit", "value"],
              "properties": {
                "concept": {"type": "string", "maxLength": 200},
                "period": {"type": "string", "maxLength": 64},
                "unit": {"type": "string", "maxLength": 64},
                "value": {"type": "string", "maxLength": 64}
              }
            }
          }
        }
      }
    },
    "assumptions": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 500}},
    "abstain": {"type": "boolean"},
    "reason": {"type": "string", "maxLength": 2000},
    "tool_requests": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "arguments_json"],
        "properties": {
          "name": {"type": "string", "maxLength": 64},
          "arguments_json": {"type": "string", "maxLength": 4000}
        }
      }
    }
  }
}
