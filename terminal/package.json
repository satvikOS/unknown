{
  "name": "unknown-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Project Unknown browser terminal (ADR-0013): a typed view of authoritative system state and an authenticated command surface.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
